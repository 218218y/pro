{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true
  },
  "include": [
    "esm/native/kernel/**/*.ts",
    "esm/native/runtime/**/*.ts",
    "esm/native/platform/**/*.ts",
    "esm/native/builder/core_carcass_*.ts",
    "esm/native/builder/room_architecture_*.ts",
    "esm/native/builder/room_shared_state.ts",
    "esm/native/features/hex_cell/hex_cell.ts",
    "esm/native/builder/corner_geometry_plan.ts",
    "esm/native/builder/corner_connector_cornice_*.ts",
    "esm/native/builder/corner_cornice_*.ts",
    "esm/native/builder/corner_wing_cornice_*.ts",
    "esm/native/builder/corner_connector_emit*.ts",
    "esm/native/builder/corner_connector_interior*.ts",
    "esm/native/builder/corner_wing_carcass*.ts",
    "esm/native/builder/corner_wing_extension_cells*.ts",
    "esm/native/builder/corner_wing_hex_cell_geometry.ts",
    "types/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "libs/**", "dist", "release"]
}
