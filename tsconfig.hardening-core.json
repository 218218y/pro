{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true
  },
  "include": [
    "esm/native/kernel/**/*.ts",
    "esm/native/runtime/**/*.ts",
    "esm/native/platform/**/*.ts",
    "types/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "libs/**", "dist", "release"]
}
